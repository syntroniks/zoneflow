{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntroniks.github.io/zoneflow/schemas/esp-web-tools-manifest.schema.json",
  "title": "ESP Web Tools manifest",
  "description": "Written from the Manifest and Build interfaces of esp-web-tools 10.4.0 (src/const.ts). Stricter than the library: unknown keys are errors, so a typo cannot silently turn an option off.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "builds"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "home_assistant_domain": {
      "type": "string"
    },
    "funding_url": {
      "type": "string"
    },
    "new_install_skip_erase": {
      "type": "boolean",
      "deprecated": true
    },
    "new_install_prompt_erase": {
      "type": "boolean"
    },
    "new_install_improv_wait_time": {
      "type": "number",
      "minimum": 0,
      "description": "Seconds to wait for Improv Wi-Fi. 0 disables."
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chipFamily",
          "parts"
        ],
        "properties": {
          "chipFamily": {
            "enum": [
              "ESP32",
              "ESP32-C2",
              "ESP32-C3",
              "ESP32-C5",
              "ESP32-C6",
              "ESP32-C61",
              "ESP32-H2",
              "ESP32-P4",
              "ESP32-S2",
              "ESP32-S3",
              "ESP8266"
            ]
          },
          "serialType": {
            "enum": [
              "cdc",
              "uart"
            ]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "offset"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^/\\\\:]+$",
                  "description": "File in the manifest's own directory; no path separators."
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
