{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntroniks.github.io/zoneflow/hardware/review/handoff.schema.json",
  "title": "ZoneFlow review hand-off, version 1",
  "description": "The owner's decisions from the pre-order review walkthrough of the ZoneFlow rev A board, for a coding agent to record and act on. Written by the walkthrough page, read by `reviewwalk record`. No board has been made: a decision is a look at design files.",
  "type": "object",
  "required": ["schema", "schema_version", "repository", "issue", "board", "site_commit", "reviewed_on", "summary", "decisions"],
  "properties": {
    "schema": { "const": "zoneflow-review-handoff" },
    "schema_version": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "issue": { "type": "integer", "description": "The issue of the repository that tracks the prototype build." },
    "board": {
      "type": "object",
      "required": ["revision", "file", "sha256"],
      "properties": {
        "revision": { "type": "string" },
        "file": { "type": "string", "description": "Path of the board file from the root of the repository." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the board file the pictures of the walkthrough were drawn from." }
      }
    },
    "site_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}( with local changes)?|unknown)$",
      "description": "The commit the walkthrough page was built from."
    },
    "reviewed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": {
      "type": "object",
      "required": ["steps", "pass", "accepted", "fail", "rejected", "not_sure", "not_answered"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "decisions": {
      "type": "array",
      "description": "One entry for every step of the walkthrough, in its order.",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["step", "title", "group", "kind", "decision", "note"],
      "properties": {
        "step": { "type": "string", "minLength": 1, "description": "The id of the step, as in docs/hardware/review/data/." },
        "title": { "type": "string" },
        "group": { "type": "string" },
        "group_title": { "type": "string" },
        "kind": { "enum": ["check", "decision"], "description": "A check is passed or failed. A decision is accepted or rejected." },
        "decision": { "enum": ["pass", "fail", "accepted", "rejected", "not_sure", "not_answered"] },
        "note": { "type": "string", "description": "The owner's own words. May be empty." },
        "designators": { "type": "array", "items": { "type": "string" } },
        "nets": { "type": "array", "items": { "type": "string" } },
        "position": {
          "description": "Where on the board, in millimetres from the lower left corner seen from the component side, and as KiCad's default display shows it. Null where the step has no one place.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["x_mm", "y_mm", "kicad_x_mm", "kicad_y_mm"],
              "additionalProperties": { "type": "number" }
            }
          ]
        },
        "pictures": { "type": "array", "items": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" } } } },
        "files": { "type": "array", "items": { "type": "string" }, "description": "Source files a change would be made in. Generated files are not listed." },
        "source": { "type": "string", "description": "The checklist item or section of a review the step comes from." },
        "findings": { "type": "array", "items": { "type": "string" } },
        "remedy": {
          "type": "object",
          "required": ["choice", "text"],
          "properties": {
            "choice": { "enum": ["agent", "listed", "own"], "description": "agent: the owner chose none and the agent proposes one. listed: one of the remedies the step offers. own: the owner's own words." },
            "id": { "type": "string", "minLength": 1 },
            "text": { "type": "string" }
          },
          "allOf": [
            { "if": { "properties": { "choice": { "const": "listed" } } }, "then": { "required": ["id"] } },
            { "if": { "properties": { "choice": { "const": "own" } } }, "then": { "properties": { "text": { "pattern": "\\S" } } } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "check" } } },
          "then": { "properties": { "decision": { "enum": ["pass", "fail", "not_sure", "not_answered"] } } },
          "else": { "properties": { "decision": { "enum": ["accepted", "rejected", "not_sure", "not_answered"] } } }
        },
        {
          "if": { "properties": { "decision": { "enum": ["fail", "rejected", "not_sure", "not_answered"] } } },
          "then": { "required": ["designators", "nets", "position", "pictures", "files", "source", "findings"] }
        },
        {
          "if": { "properties": { "decision": { "enum": ["fail", "rejected"] } } },
          "then": { "required": ["remedy"] }
        }
      ]
    }
  }
}
