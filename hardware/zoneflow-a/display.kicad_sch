	(text "Display connector and backlight switch"
		(exclude_from_sim no)
		(at 234.95 48.92 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "26454814-3f3f-530b-8862-8f6eb552e8d7")
	)
	(text "DISPLAY (hardware design section 15).\nDS1 HS20HS072RX, 2.0 inch 240 x 320 IPS, ST7789, write-only 4-wire SPI on SPI2:\nSCLK GPIO12, MOSI GPIO11, CS GPIO10, DC GPIO13, RST GPIO14. Start at 15 MHz.\nJ7 is a bottom-contact flip-lock connector. Its pad 1 is panel pin 1 (GND): the pad nearest the\nterminal-block edge, at y = 85.68 in the mechanical contract. The contacts of the tail are on the\ndisplay face; folded under the panel they face the board. Check both on a sample panel.\nBacklight: four LEDs in parallel, about 3.0 V. R60 33R from V5 gives 59 mA at 24 VAC and 27 mA\nat the lowest USB voltage. Q4 switches the cathode under PWM from GPIO21, 1 to 20 kHz.\nR62 holds Q4 off in reset. R63 holds RST high. C37 and C38 at J7 pins 8 and 9.\nLAYOUT: keep J7 within about 40 mm of module pins 18 to 22. TFT_BL keeps toggling when the\nfirmware hangs: it must never run next to KA (section 8.5)."
		(exclude_from_sim no)
		(at 233.68 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5ca97afb-6b13-52f4-aa40-a833762f867f")
	)
	(text "Encoder and buttons: five debounced contacts, active low"
		(exclude_from_sim no)
		(at 31.75 33.68 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "66f24044-4007-564a-a6d2-ba264344cd27")
	)
	(text "DS1 is the panel itself. It has no footprint:\nits 12-way tail plugs into J7 at final assembly."
		(exclude_from_sim no)
		(at 342.9 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b3fda878-f600-5d04-814b-30ed39cd1d19")
	)
	(text "CONTROLS (section 15.4).\nSW3 EC11J1525402: 30 detents, 15 pulses per turn, push switch.\nSW4 Back and SW5 Manual / Home: 6 x 6 mm, 10 mm actuator.\nEach contact: 3.3k pull-up (1 mA, the encoder's minimum),\nthen 10k and 100 nF: 1.0 ms closing, 1.3 ms opening.\nAll five inputs read low when the contact is closed."
		(exclude_from_sim no)
		(at 177.8 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e39c9247-4097-5c14-9a16-bc4c09856ec4")
	)
