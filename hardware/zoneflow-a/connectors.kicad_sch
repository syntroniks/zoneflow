		(uuid "155f9aaf-7ec2-58a8-a311-31f2747cace1")
	)
	(text "Terminal order along the bottom edge, left to right as the installer sees it:\nJ1  24V~  24V~          transformer; pin 2 (AC_N) becomes circuit GND\nJ2  COM  COM  MV  1  2  3  4\nJ3  5  6  7  8          8-zone build only (KiCad variant \"4-zone\": not fitted)\nJ4  5V  FLOW  GND  RAIN  GND  AUX  GND\nHeaders KF2EDGR-3.81, plugs KF2EDGK-3.81 supplied loose. 300 V, 8 A.\nMark terminal 2 of J1 on the silkscreen."
		(exclude_from_sim no)
		(at 96.52 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3844148a-2a1b-5b41-84c7-59d3c283db55")
	)
	(text "TEST PADS: 1.5 mm, top side. Ground around TP8.\nNo pad may sit in the fuse well."
