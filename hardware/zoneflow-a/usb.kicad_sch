	(text "USB-C device port"
		(exclude_from_sim no)
		(at 29.21 41.3 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "564f2471-a5a4-5ce4-b061-e1bfb228afb7")
	)
	(text "Power OR-ing and 3.3 V regulator"
		(exclude_from_sim no)
		(at 171.45 20.98 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "b1f2b9bc-3e55-5a92-8529-2f363288144f")
	)
	(text "USB-C AND POWER OR-ING (hardware design section 5).\nJ5 is a USB 2.0 device port. R15 and R16, 5.1k on CC1 and CC2, mark the board as a device.\nU2 clamps D+, D- and VBUS: place it at J5. R97 and R98 are 0R, C52 and C53 are not fitted:\nseries and shunt footprints for EMC work, placed within a few millimetres of the module pins.\nD3 (from V_BUCK) and D4 (from VBUS) OR the two sources onto V5: about 4.95 V from 24 VAC,\n4.1 to 4.9 V from USB. Neither source can feed the other. USB alone runs the logic, not the valves.\nU3 LDL1117S33R: 3V3 is 3.20 to 3.40 V. Load 162 mA typical, 498 mA peak. Give the tab copper.\nUSB ground is circuit ground, which is one leg of the 24 VAC transformer: read section 5.3\nand the safety page before connecting a mains-powered computer."
		(exclude_from_sim no)
		(at 17.78 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f54f04d1-f14b-5a98-b4d3-9997466c110c")
	)
