{
  "name": "zoneflow-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI served by the ZoneFlow standalone firmware",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.ts --port 8787",
    "gen:api": "node scripts/gen-api.ts",
    "check:api": "node scripts/gen-api.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/pack.ts",
    "size": "node scripts/pack.ts --check-only",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots && node scripts/shrink-png.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
