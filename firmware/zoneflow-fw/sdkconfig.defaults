# ZoneFlow defaults. sdkconfig is generated from this file; do not commit it.
CONFIG_IDF_TARGET="esp32s3"

# Flash and partitions: 8 MB, two OTA slots, web assets, core dump.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Logs and flashing over the native USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 kHz tick so the 5 ms keep-alive period is exact.
CONFIG_FREERTOS_HZ=1000

# Watchdogs: the control task is subscribed to the task watchdog.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_INT_WDT=y

# Brownout detector with interrupt so the output-off callback runs.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_USE_INTR=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# ---- Network, web and OTA (zf_net, zf_web, zf_ota) ----
# BLE provisioning: NimBLE host, peripheral role only, one connection.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Unified provisioning with Security 2 (SRP6a + AES-GCM) only.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
CONFIG_WIFI_PROV_STA_ALL_CHANNEL_SCAN=y
# 802.11k/v so mesh systems can steer the station.
CONFIG_ESP_WIFI_11KV_SUPPORT=y
# HTTP server: 9 handlers plus SoftAP provisioning endpoints, longer headers
# (cookies), optional HTTPS. Sockets: 7 HTTP + 4 HTTPS + DNS, mDNS, SNTP.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_LWIP_MAX_SOCKETS=16
# TLS buffers allocated per record, not 2 x 16 KB per session.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
