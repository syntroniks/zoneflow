menu "ZoneFlow board"

    choice ZF_BOARD
        prompt "Board"
        default ZF_BOARD_REV_A
        help
            Board definition header used for pins and board constants.

        config ZF_BOARD_REV_A
            bool "ZoneFlow rev A (provisional pin map)"
    endchoice

    choice ZF_OE_MODE
        prompt "Output-enable signal type"
        default ZF_OE_MODE_TOGGLE
        help
            How the hardware output-enable (OE) gate expects to be driven.
            Toggle: a retriggerable keep-alive that needs edges (watchdog
            style). Required by system spec v0.2 for rev A.
            Static: a plain enable level, held while outputs may be on. For
            other hardware only.
            Either way OE goes inactive when the control loop stops.

        config ZF_OE_MODE_TOGGLE
            bool "Toggle (retriggerable)"
        config ZF_OE_MODE_STATIC
            bool "Static level"
    endchoice

    config ZF_OE_TOGGLE_PERIOD_MS
        int "Keep-alive period (ms)"
        range 1 100
        default 5
        help
            Period of the keep-alive timer interrupt (GPTimer, IRAM-safe). In
            toggle mode, one edge per period.

    config ZF_OE_HEARTBEAT_TIMEOUT_MS
        int "Control-loop heartbeat timeout (ms)"
        range 100 5000
        default 500
        help
            The keep-alive interrupt stops driving OE when the control loop
            has not run for this long, counted in keep-alive periods. A flash
            erase stalls the control loop; OE survives stalls shorter than
            this.

    config ZF_CONTROL_PERIOD_MS
        int "Control loop period (ms)"
        range 10 200
        default 50

    config ZF_DISPLAY_ON_SHARED_PINS
        bool "Give GPIO18, 47 and 48 to the display (provisional pin map)"
        default n
        help
            The provisional pin map has three pins fewer than the firmware
            wants. GPIO18, 47 and 48 carry the hardware over-current trip
            and the zero-cross input by default, and the display is then
            not started. With this option they carry the display's SPI
            clock, data and backlight instead, and the over-current trip
            and zero-cross inputs are treated as not fitted.
            This switch goes away when hardware/pinmap.yaml exists.

endmenu
